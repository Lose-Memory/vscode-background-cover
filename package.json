{
    "name": "background-cover",
    "displayName": "background-cover",
    "description": "Add a picture you like to cover the entire vscode background (Hot Reload Supported). / 添加你喜欢的图片覆盖整个vscode背景（支持热更新）",
    "version": "3.12.20",
    "publisher": "manasxx",
    "engines": {
        "vscode": "^1.38.0"
    },
    "one_title": true,
    "icon": "resources/background-cover.png",
    "galleryBanner": {
        "color": "#03385a",
        "theme": "dark"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "Background",
        "Theme"
    ],
    "activationEvents": [
        "*"
    ],
    "license": "ISC",
    "main": "./out/extension",
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "contributes": {
        "commands": [
            {
                "command": "extension.backgroundCover.start",
                "title": "打开面板"
            },
            {
                "command": "extension.backgroundCover.refresh",
                "title": "刷新背景"
            },
            {
                "command": "backgroundCover.refreshEntry",
                "title": "刷新",
                "icon": {
                    "light": "resources/light/refresh.svg",
                    "dark": "resources/dark/refresh.svg"
                }
            },
            {
                "command": "backgroundCover.switchMode",
                "title": "配置",
                "icon": "$(settings-gear)"
            }
        ],
        "keybindings": [
            {
                "command": "extension.backgroundCover.refresh",
                "key": "ctrl+shift+f7"
            }
        ],
        "configuration": {
            "title": "背景封面设置",
            "properties": {
                "backgroundCover.opacity": {
                    "type": "number",
                    "maximum": 0.8,
                    "minimum": 0,
                    "default": 0.2,
                    "description": "背景透明度（0 - 0.8）"
                },
                "backgroundCover.blur": {
                    "type": "number",
                    "maximum": 100,
                    "minimum": 0,
                    "default": 0,
                    "description": "背景模糊（0 - 100）"
                },
                "backgroundCover.imagePath": {
                    "type": "string",
                    "default": "",
                    "description": "背景图片路径"
                },
                "backgroundCover.dataDir": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "markdownDescription": "插件数据的存放位置（缩略图、单图取景位置、目录扫描结果）。留空存在 VS Code 的扩展存储目录，**卸载扩展时会一起删除**；指定一个自己的文件夹后，卸载不会删除这里的数据。只保存本插件自己的数据，不涉及 VS Code 或其它扩展的配置。"
                },
                "backgroundCover.perWindowBackground": {
                    "type": "boolean",
                    "default": true,
                    "description": "每个窗口使用各自的背景图；关闭后所有窗口共用同一张背景图（旧版行为）"
                },
                "backgroundCover.activePlaylist": {
                    "type": "string",
                    "enum": [
                        "1",
                        "2"
                    ],
                    "default": "1",
                    "markdownDescription": "当前使用的播放列表：随机换图、图库与目录扫描都用它的目录，其余设置两个列表共用。"
                },
                "backgroundCover.playlist1Folder": {
                    "type": "string",
                    "default": "",
                    "description": "播放列表 1 的目录（递归扫描子目录）"
                },
                "backgroundCover.playlist2Folder": {
                    "type": "string",
                    "default": "",
                    "description": "播放列表 2 的目录（递归扫描子目录）"
                },
                "backgroundCover.randomImageFolder": {
                    "type": "string",
                    "default": "",
                    "deprecationMessage": "已迁移到 backgroundCover.playlist1Folder",
                    "description": "已弃用：播放列表 1 的目录（启动时自动迁移）"
                },
                "backgroundCover.folderScanDepth": {
                    "type": "number",
                    "default": 3,
                    "minimum": 0,
                    "maximum": 10,
                    "description": "扫描子目录的层数（0 = 只看当前目录，默认 3 层）"
                },
                "backgroundCover.aspectThreshold": {
                    "type": "number",
                    "default": 1.3,
                    "minimum": 0.1,
                    "maximum": 10,
                    "description": "竖图阈值：宽高比小于该值的图视为竖图（比例筛选与纵向取景共用）"
                },
                "backgroundCover.aspectFilterEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "随机换图时只挑选宽高比 ≥ 竖图阈值的图片；图库仍显示全部"
                },
                "backgroundCover.portraitVerticalPosition": {
                    "type": "number",
                    "default": 50,
                    "minimum": 0,
                    "maximum": 100,
                    "description": "竖图纵向取景位置（0 = 顶部，50 = 居中，100 = 底部）"
                },
                "backgroundCover.autoStatus": {
                    "type": "boolean",
                    "default": false,
                    "description": "每次启动时随机自动更换背景"
                },
                "backgroundCover.autoInterval": {
                    "type": "number",
                    "default": 10,
                    "description": "自动更换背景的时间间隔（秒）"
                },
                "backgroundCover.autoRandomOnStartup": {
                    "type": "boolean",
                    "default": true,
                    "description": "启动窗口时随机换一张新图（与定时自动换图互不影响）"
                },
                "backgroundCover.sizeModel": {
                    "type": "string",
                    "enum": [
                        "cover",
                        "repeat",
                        "contain",
                        "center",
                        "not_center",
                        "not_right_bottom",
                        "not_right_top",
                        "not_left",
                        "not_right",
                        "not_top",
                        "not_bottom"
                    ],
                    "default": "cover",
                    "description": "图片尺寸适应模式"
                },
                "backgroundCover.blendModel": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "multiply",
                        "lighten"
                    ],
                    "default": "auto",
                    "description": "图片文字混合模式，对应主题模式"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "backgroundCover-explorer",
                    "title": "背景封面",
                    "icon": "resources/big.svg"
                }
            ]
        },
        "views": {
            "backgroundCover-explorer": [
                {
                    "id": "backgroundCover.studio",
                    "type": "webview",
                    "name": "工作室",
                    "when": "backgroundCover.mode == 'menu'"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "backgroundCover.refreshEntry",
                    "when": "view == backgroundCover.studio",
                    "group": "navigation@0"
                }
            ]
        }
    },
    "bugs": {
        "url": "https://github.com/Lose-Memory/vscode-background-cover/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Lose-Memory/vscode-background-cover.git"
    },
    "homepage": "https://github.com/Lose-Memory/vscode-background-cover#readme",
    "scripts": {
        "vscode:prepublish": "npm run build:webview && npm run compile",
        "vscode:uninstall": "node ./out/uninstall",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package",
        "build:webview": "cd webview && npm install --silent && npm run build",
        "watch:webview": "cd webview && npm run dev",
        "test": "npm run compile && node ./node_modules/vscode/bin/test",
        "test:newfeatures": "npm run compile && node scripts/test-new-features.js",
        "test:autorefresh": "npm run compile && node scripts/test-auto-refresh.js",
        "test:unit": "npm run compile && node scripts/test-config-update.js && node scripts/test-auto-refresh.js && node scripts/test-new-features.js",
        "check": "tslint -p ./"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/lockfile": "^1.0.4",
        "@types/mocha": "^5.2.7",
        "@types/node": "^22.9.0",
        "@types/proper-lockfile": "^4.1.4",
        "@types/vscode": "^1.30.0",
        "@vscode/test-electron": "^2.3.2",
        "@vscode/vsce": "^3.9.2",
        "typescript": "^4.5.4"
    },
    "dependencies": {
        "@vscode/sudo-prompt": "^9.3.2",
        "async-mutex": "^0.5.0",
        "fs-extra": "^11.2.0",
        "proper-lockfile": "^4.1.2",
        "sharp": "^0.35.5"
    }
}
